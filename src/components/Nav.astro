---
// The top bar. It sits *over* the hero rather than above it: transparent at
// the top of the page, and only picking up a solid background once you scroll
// past the imagery (otherwise white links would vanish on the cream sections).
const links = [
  { href: '/',      label: 'home',  emoji: '🏠' },
  { href: '/work',  label: 'work' },
  { href: '/other', label: 'other' },
  { href: '/about', label: 'about' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="nav" id="site-nav">
  <a class="brand" href="/">
    <img class="brand__mark" src="/images/RBanner.png" alt="" width="34" height="34" />
    <span class="brand__name">rally pagulayan</span>
  </a>

  <nav aria-label="Main">
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} class:list={[{ active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.emoji && <span class="emoji">{l.emoji}</span>}{l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-inline: 20px;
    background: transparent;
    transition: background-color 180ms ease;
  }

  /* A soft scrim so the links stay legible over a bright patch of photograph,
     without drawing a visible bar. It fades out once the bar goes solid. */
  .nav::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
    transition: opacity 180ms ease;
  }

  .nav.is-stuck {
    background: rgba(18, 18, 18, 0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .nav.is-stuck::before { opacity: 0; }

  .brand,
  .nav nav {
    position: relative;
    z-index: 1;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
  }

  .brand__mark {
    width: 34px;
    height: 34px;
    flex: none;
    object-fit: contain;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.5));
  }

  .brand__name {
    font-size: 17px;
    font-weight: 300;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-size: 13.5px;
    text-decoration: none;
    color: var(--text);
    opacity: 0.88;
    white-space: nowrap;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
  }

  nav a:hover { opacity: 1; }
  nav a.active { font-weight: 500; opacity: 1; }

  .emoji { margin-right: 4px; }

  @media (max-width: 560px) {
    .brand__name { display: none; }
    nav ul { gap: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav, .nav::before { transition: none; }
  }
</style>
