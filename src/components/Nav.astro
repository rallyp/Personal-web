---
// The top bar. Rendered on every page by Base.astro, so there is only
// ever one copy of this markup to edit.
const links = [
  { href: '/',      label: 'home',  emoji: '🏠' },
  { href: '/work',  label: 'work' },
  { href: '/other', label: 'other' },
  { href: '/about', label: 'about' },
];

// Astro.url.pathname is the URL of the page being built, e.g. "/work".
// We use it to bold the link for the page you are currently on.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="nav">
  <a class="brand" href="/">
    <!-- Placeholder mark. Swap in the real flag logo at /public/images/logo.png -->
    <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true">
      <path d="M8 4 v32" stroke="#e8e8e8" stroke-width="2.5" stroke-linecap="round" />
      <path d="M9 5 C20 2, 28 10, 38 7 C30 13, 24 16, 9 17 Z" fill="var(--accent)" />
    </svg>
    <span class="brand__name">rally pagulayan</span>
  </a>

  <nav aria-label="Main">
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} class:list={[{ active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.emoji && <span class="emoji">{l.emoji}</span>}{l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-inline: 20px;
    background: var(--nav-bg);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
  }

  .brand__mark { width: 30px; height: 30px; flex: none; }

  .brand__name { font-size: 17px; font-weight: 300; letter-spacing: 0.01em; }

  nav ul {
    display: flex;
    align-items: center;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-size: 13.5px;
    text-decoration: none;
    color: var(--text);
    opacity: 0.85;
    white-space: nowrap;
  }

  nav a:hover { opacity: 1; }

  nav a.active { font-weight: 500; opacity: 1; }

  .emoji { margin-right: 4px; }

  @media (max-width: 560px) {
    .brand__name { display: none; }
    nav ul { gap: 14px; }
  }
</style>
