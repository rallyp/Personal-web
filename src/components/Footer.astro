---
import SocialRow from './SocialRow.astro';

// One place to edit the standing bio that repeats at the foot of every page.
const bio = [
  'American, Canadian, Filipino',
  'Greyhound aficionado',
  'Fan of food, drink, and sports.',
  'UX research and design professional of 30 years',
];

const year = new Date().getFullYear();
---

<footer class="foot">
  <hr class="rule" />
  <div class="wrap foot__inner">
    {bio.map((line) => <p>{line}</p>)}

    <SocialRow />
  </div>

  <div class="foot__legal">
    <div class="wrap">© Rally Pagulayan, {year}</div>
  </div>
</footer>

<style>
  .foot {
    background: var(--bg);
    padding-top: 40px;
  }

  .foot__inner {
    text-align: center;
    padding-bottom: 40px;
  }

  .foot__inner p {
    margin: 0 0 6px;
    font-size: 14px;
    color: var(--text);
  }

  .foot__inner a { text-decoration: underline; text-underline-offset: 3px; }

  .foot__legal {
    border-top: 1px solid var(--rule);
    padding-block: 16px;
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
