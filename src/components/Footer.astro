---
import SocialRow from './SocialRow.astro';

// One place to edit the standing bio that repeats at the foot of every page.
const bio = [
  'UX research and design professional of 30 years',
  'Wrangler of greyhound',
  'American, Canadian, Filipino',
  'Fan of food, drink. and sport.',
];

const year = new Date().getFullYear();
---

<footer class="foot">
  <hr class="rule" />
  <div class="wrap foot__inner">
    <p>CEO of <a href="https://www.echouser.com" target="_blank" rel="noopener noreferrer">EchoUser</a>, a UX Research and Design Firm</p>
    {bio.map((line) => <p>{line}</p>)}

    <SocialRow />
  </div>

  <div class="foot__legal">
    <div class="wrap">© Rally Pagulayan, {year}</div>
  </div>
</footer>

<style>
  .foot {
    background: var(--bg);
    padding-top: 40px;
  }

  .foot__inner {
    text-align: center;
    padding-bottom: 40px;
  }

  .foot__inner p {
    margin: 0 0 6px;
    font-size: 14px;
    color: var(--text);
  }

  .foot__inner a { text-decoration: underline; text-underline-offset: 3px; }

  .foot__legal {
    border-top: 1px solid var(--rule);
    padding-block: 16px;
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
