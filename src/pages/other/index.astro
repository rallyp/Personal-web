---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import Placeholder from '../../components/Placeholder.astro';

const greyhoundDesigns = [
  'greyhound design 1', 'greyhound design 2', 'greyhound design 3', 'greyhound design 4',
  'greyhound design 5', 'greyhound design 6', 'greyhound design 7', 'greyhound design 8',
];

const bernalDesigns = ['Bernal Heights flag design', 'Bernal Heights badge design', 'California 67 design'];
---

<Base title="rally pagulayan - other" heroAtTop>
  <PageBanner
    title="Other"
    subtitle="These are some of the things I do to keep myself entertained..."
  />

  <section class="section" id="greyhounds">
    <div class="wrap">
      <div class="split">
        <div class="split__body">
          <h2 class="h-section">Greyhounds</h2>
          <p>
            Greyhounds make great (greyt) pets! I'm a fan. We currently have one retired racer and
            we've had two previously. I also fostered many for my first adoption group. I'm a fan and
            love this breed. As a way to expend some creative energy, I've messed around with various
            images for t-shirts and the like. You can check them out below.
          </p>
        </div>
        <div class="split__media">
          <Placeholder label="standing greyhound photo" ratio="3 / 4" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cream" id="for-sale">
    <div class="wrap">
      <h2 class="h-section">Greyhound themed stuff for sale</h2>

      <div class="stores">
        <a class="store" href="https://rallyp.threadless.com" target="_blank" rel="noopener noreferrer">
          <Placeholder label="Threadless logo" ratio="16 / 5" />
          <span>Threadless</span>
        </a>
        <a class="store" href="https://rallyp.redbubble.com" target="_blank" rel="noopener noreferrer">
          <Placeholder label="Redbubble logo" ratio="16 / 5" />
          <span>Redbubble</span>
        </a>
      </div>

      <div class="grid">
        {greyhoundDesigns.map((d) => <Placeholder label={d} ratio="1 / 1" />)}
      </div>
    </div>
  </section>

  <section class="section" id="comics">
    <div class="wrap">
      <h2 class="h-section centered">Greyhound comics</h2>
      <div class="comics">
        <Placeholder label="comic photo — greyhound with PBR" ratio="1 / 1" />
        <Placeholder label="comic photo — greyhound at microphones" ratio="1 / 1" />
        <div class="comics__text">
          <p>
            Once upon a time, I was greatly inspired by a greyhound-themed photo comic called Shades of
            Greyhounds. Sadly, it no longer exists, but I did a (poor) emulation of it. Here are some of
            the remnants of that...
          </p>
          <a class="more" href="/other/gh-comics">see more comics here!</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--cream" id="bernal">
    <div class="wrap">
      <h2 class="h-section">Bernal Heights merch</h2>
      <p class="centered-note">Repping the lovely San Francisco neighborhood of Bernal Heights.</p>
      <div class="grid grid--three">
        {bernalDesigns.map((d) => <Placeholder label={d} ratio="1 / 1" />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .centered { text-align: center; }

  .centered-note { text-align: center; margin: 0 0 32px; font-size: 14px; }

  .stores {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 220px));
    justify-content: center;
    gap: 40px;
    margin-bottom: 32px;
  }

  .store { text-decoration: none; color: inherit; text-align: center; }
  .store span { display: block; margin-top: 8px; font-size: 13px; }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    max-width: 560px;
    margin-inline: auto;
  }

  .grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 460px; }

  .comics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }

  .comics__text p { margin-top: 0; }

  @media (max-width: 800px) {
    .comics { grid-template-columns: 1fr; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
