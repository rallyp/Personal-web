---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import SongList from '../components/SongList.astro';
import { listTitle, listIntro, listRule, songs, isFilled } from '../data/songs';

const filled = songs.filter(isFilled).length;
---

<Base
  title={`rally pagulayan - ${listTitle.toLowerCase()}`}
  description="Rally Pagulayan's twenty favourite songs, a list that will keep changing."
  heroAtTop
>
  <PageBanner title="Favorite 20 songs" subtitle={listIntro} />

  <section class="section">
    <div class="wrap narrow">
      <p class="rule-note">{listRule}</p>

      <SongList showNotes />

      {filled < songs.length && (
        <p class="note">
          {filled} of {songs.length} decided so far. The rest are still being argued over.
        </p>
      )}

      <p class="back">
        <a href="/thoughts">&larr; Back to thoughts</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .narrow { max-width: 760px; }

  .rule-note {
    margin: 0 0 28px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .note {
    margin-top: 26px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .back { margin-top: 40px; font-size: 14px; }
  .back a { text-decoration: underline; text-underline-offset: 3px; }
</style>
