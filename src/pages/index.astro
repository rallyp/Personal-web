---
import Base from '../layouts/Base.astro';
---

<Base title="rally pagulayan" heroAtTop>
  <section class="hero">
    <!-- Source photo kept at src/images-source/LimaPodium.png -->
    <div class="hero__bg" aria-hidden="true"></div>

    <div class="hero__inner">
      <h1>Hello there.</h1>
    </div>
    <a class="hero__chevron" href="#intro" aria-label="Scroll down">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </section>

  <span id="intro"></span>
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;   /* svh accounts for mobile browser chrome */
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #050505;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/hero-lima.jpg');
    background-size: cover;
    background-position: center;
    background-color: #000;
  }

  /* Kept as a wrapper: it holds the hero content above .hero__bg, and is
     where a mark or sub-line would go back in. */
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .hero h1 {
    font-family: var(--font-display);
    /* min 3rem on a phone, scales with the viewport, caps at 8rem on desktop */
    font-size: clamp(3rem, 10vw, 8rem);
    letter-spacing: -0.035em;
    color: var(--heading-hero);
    text-align: center;
    padding-inline: 24px;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.55);
  }

  .hero__chevron {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.75);
  }

  .hero__chevron svg { width: 30px; height: 30px; }
</style>
